# ==========================================
# MarketLens Environment Variables
# ==========================================

# Image Tag (used for registry.acimisai.com images)
IMAGE_TAG=v1

# Port Configuration (Machine Independent - all ports controlled here)
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
NGINX_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Application URLs & Routing
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://backend:8000

# AI Model
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_gemini_api_key

# Database (Central PostgreSQL via PgBouncer - provisioned by pcc)
DATABASE_URL=postgresql://marketlens_owner:replace_with_password@pg_central_pgbouncer:6432/marketlens
POSTGRES_HOST=pg_central_pgbouncer
POSTGRES_PORT=6432
POSTGRES_DB=marketlens
POSTGRES_USER=marketlens_owner
POSTGRES_PASSWORD=replace_with_password

# Security & CORS
SECRET_KEY=replace_with_secure_random_hex_or_string
ALLOWED_ORIGINS=*

# Observability / Monitoring (if enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_secure_grafana_password
