# ==========================================
# MarketLens Environment Variables
# ==========================================
# Copy this file to .env and fill in your secrets


# Database Credentials
DB_USER=marketlens_user
DB_PASSWORD=secret_db_password
DB_NAME=marketlens_db

# Backend specific variables
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}
SECRET_KEY=super_secret_key_change_in_production
ALLOWED_ORIGINS=*

# Frontend specific variables
NEXT_PUBLIC_API_URL=https://api.your-production-domain.com

# Observability / Grafana (if enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
