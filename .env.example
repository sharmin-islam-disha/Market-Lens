# ==========================================
# MarketLens Environment Variables
# ==========================================

# Port Configuration (Machine Independent - all ports controlled here)
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
NGINX_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Application URLs & Routing
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://backend:8000

# AI Model
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_gemini_api_key

# Database Credentials (PostgreSQL)
DB_USER=marketlens_user
DB_PASSWORD=replace_with_secure_database_password
DB_NAME=marketlens_db
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# Security & CORS
SECRET_KEY=replace_with_secure_random_hex_or_string
ALLOWED_ORIGINS=*

# Observability / Monitoring (if enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_secure_grafana_password
