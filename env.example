# ═══════════════════════════════════════════════════════════════
#  MarketLens — env.example
#  Copy to .env, fill in values, chmod 600 .env
# ═══════════════════════════════════════════════════════════════

# Image tag — must match what was built/pushed via build.docker-compose.yml on main
VERSION=1.0.0

# ── Backend ─────────────────────────────────────────────────────
PORT=8000
SECRET_KEY=replace_with_secure_random_hex_64_chars
ALLOWED_ORIGINS=https://your-domain.com

# AI Vision model — no server-level API key; each user provides their own via Settings
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://marketlens-backend:8000

# ── Database (Central PostgreSQL via PgBouncer) ──────────────────
# Provisioned with: ./postgres/pcc marketlens  (on the central ops host)
# Paste the generated DATABASE_URL verbatim — never hand-invent the password
DATABASE_URL=postgresql://marketlens_owner:replace_with_pcc_password@pg_central_pgbouncer:6432/marketlens
