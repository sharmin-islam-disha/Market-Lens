# Image tag (built/pushed via build.docker-compose.yml on main)
VERSION=1.0.0

# ── Backend ────────────────────────────────────────────────────
PORT=8000
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
SECRET_KEY=replace_with_secure_random_hex
ALLOWED_ORIGINS=https://your-domain.com

# ── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
BACKEND_URL=http://marketlens-backend:8000

# ── Database (via central PgBouncer — provisioned with ./postgres/pcc marketlens) ──
DATABASE_URL=postgresql://marketlens_owner:replace_with_password@pg_central_pgbouncer:6432/marketlens
